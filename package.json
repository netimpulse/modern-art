{
  "name": "shopify-theme-template",
  "version": "0.1.0",
  "private": true,
  "description": "Template fuer neue Shopify-Theme-Repos mit integriertem Visual-QA-Workflow (Shopify CLI + Playwright).",
  "scripts": {
    "theme:check": "shopify theme check",
    "theme:push:dev": "shopify theme push -e development --nodelete",
    "theme:push:prod": "shopify theme push -e production",
    "qa:visual": "playwright test",
    "qa:full": "npm run theme:check && npm run qa:translations && npm run qa:visual",
    "playwright:install": "playwright install chromium",
    "qa:http": "playwright test --grep @http --grep-invert @cart --workers=1",
    "qa:browser": "playwright test --grep @browser",
    "qa:translations": "node scripts/check-translations.mjs",
    "seed:dev": "node scripts/seed-dev-store.mjs",
    "qa:http:cart": "playwright test --grep @cart --workers=1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@shopify/cli": "^4.8.3"
  }
}

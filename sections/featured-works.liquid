{% comment %}
  Selected artworks from a collection, rendered with the shared artwork card.
{% endcomment %}
{{ 'component-artwork.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign scheme_id = section.settings.color_scheme.id | default: 'scheme-1'
  assign source = section.settings.collection
-%}

<div class="featured-works section-pad color-scheme color-{{ scheme_id }}">
  <header class="section-head">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="section-title">{{ section.settings.heading }}</h2>
    </div>
    <div class="featured-works__aside">
      {%- if section.settings.text != blank -%}
        <div class="section-intro rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if source != blank -%}
        <a class="link" href="{{ source.url }}">{{ section.settings.link_label | escape }}</a>
      {%- endif -%}
    </div>
  </header>

  {%- if source != blank and source.products.size > 0 -%}
    <ul class="featured-works__grid" role="list" data-featured-grid>
      {%- for product in source.products limit: section.settings.limit -%}
        <li>{% render 'artwork-card', product: product %}</li>
      {%- endfor -%}
    </ul>
  {%- else -%}
    <p class="featured-works__empty">{{ 'featured.empty' | t }}</p>
  {%- endif -%}
</div>

{% stylesheet %}
  .featured-works__aside {
    display: grid;
    gap: 16px;
    justify-items: start;
  }
  .featured-works__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(28px, 4vw, 56px) clamp(20px, 3vw, 40px);
    list-style: none;
    padding: 0;
  }
  .featured-works__empty {
    color: var(--color-muted);
  }
  @media (max-width: 1100px) {
    .featured-works__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .featured-works__grid {
      gap: 28px 14px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.featured_works",
  "class": "section-featured-works",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "Shop" },
    { "type": "inline_richtext", "id": "heading", "label": "t:labels.heading", "info": "t:info.heading_accent", "default": "Originale & <em>Editionen</em>" },
    { "type": "richtext", "id": "text", "label": "t:labels.text", "default": "<p>Jedes Werk ist signiert, kommt mit Echtheitszertifikat und wird in einer Kunstkiste versendet.</p>" },
    { "type": "collection", "id": "collection", "label": "t:labels.collection" },
    { "type": "range", "id": "limit", "min": 3, "max": 12, "step": 1, "label": "t:labels.limit", "default": 6 },
    { "type": "text", "id": "link_label", "label": "t:labels.link_label", "default": "Alle Werke ansehen" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "t:sections.featured_works" }]
}
{% endschema %}

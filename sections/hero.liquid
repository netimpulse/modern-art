{% comment %}
  Home hero: kinetic headline (accent line "breathes" via variable font weight),
  lead text, two CTAs, date blocks, and a stage with blobs, Bauhaus shapes, a
  featured artwork in a frame and a rotating badge.
{% endcomment %}
{{ 'section-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign scheme_id = section.settings.color_scheme.id | default: 'scheme-1'
  assign featured = section.settings.product
  assign hero_image = section.settings.image
  if hero_image == blank and featured != blank
    assign hero_image = featured.featured_image
  endif
  assign loading = 'lazy'
  assign priority = 'auto'
  if section.index == 1
    assign loading = 'eager'
    assign priority = 'high'
  endif
  assign accent_chars = section.settings.heading_accent | split: ''
-%}

<div class="hero full-width color-scheme color-{{ scheme_id }}">
  <div class="hero__grid page-width">
    <div class="hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="hero__title">
        <span class="hero__line">{{ section.settings.heading | escape }}</span>
        {%- if section.settings.heading_accent != blank -%}
          <span class="hero__line hero__line--accent">
            <span class="visually-hidden">{{ section.settings.heading_accent | escape }}</span>
            <span class="hero__chars" aria-hidden="true">
              {%- for char in accent_chars -%}
                {%- if char == ' ' -%}
                  <span class="hero__char">&nbsp;</span>
                {%- else -%}
                  <span class="hero__char">{{ char | escape }}</span>
                {%- endif -%}
              {%- endfor -%}
            </span>
          </span>
        {%- endif -%}
      </h1>
      {%- if section.settings.text != blank -%}
        <div class="hero__lead rte">{{ section.settings.text }}</div>
      {%- endif -%}

      <div class="hero__ctas">
        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <a class="btn" href="{{ section.settings.button_link }}">
            {{ section.settings.button_label | escape }} <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
        {%- endif -%}
        {%- if section.settings.link_label != blank and section.settings.link != blank -%}
          <a class="link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <ul class="hero__dates" role="list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              {%- capture date_inner -%}
                <small>
                  {%- if block.settings.live -%}<span class="dot dot--live"></span>{%- endif -%}
                  {{ block.settings.label | escape }}
                </small>
                <b>{{ block.settings.title | escape }}</b>
                <span>{{ block.settings.text | escape }}</span>
              {%- endcapture -%}
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}">{{ date_inner }}</a>
              {%- else -%}
                <div>{{ date_inner }}</div>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="hero__stage">
      <span class="blob blob--cobalt hero__blob hero__blob--1" aria-hidden="true"></span>
      <span class="blob blob--coral hero__blob hero__blob--2" aria-hidden="true"></span>
      <span class="blob blob--mustard hero__blob hero__blob--3" aria-hidden="true"></span>
      <span class="hero__shape hero__shape--ring" aria-hidden="true"></span>
      <span class="hero__shape hero__shape--tri" aria-hidden="true"></span>
      <span class="hero__shape hero__shape--half" aria-hidden="true"></span>
      <span class="hero__shape hero__shape--grid" aria-hidden="true"></span>

      {%- if hero_image != blank -%}
        <figure class="hero__frame">
          {%- capture frame_media -%}
            {%- assign alt = hero_image.alt | default: featured.title | default: shop.name -%}
            {{
              hero_image
              | image_url: width: 900
              | image_tag:
                class: 'hero__image',
                loading: loading,
                fetchpriority: priority,
                widths: '360, 540, 720, 900',
                sizes: '(min-width: 900px) 30vw, 66vw',
                alt: alt
            }}
          {%- endcapture -%}
          {%- if featured != blank -%}
            <a href="{{ featured.url }}" data-cursor-label="{{ 'artwork.view' | t }}">{{ frame_media }}</a>
            <figcaption>
              <span><b>{{ featured.title | escape }}</b>{% if featured.metafields.art.year.value != blank %}, {{ featured.metafields.art.year.value }}{% endif %}</span>
              {%- if featured.available and featured.metafields.art.price_on_request.value != true -%}
                <span>{{ featured.price | money }}</span>
              {%- endif -%}
            </figcaption>
          {%- else -%}
            {{ frame_media }}
          {%- endif -%}
        </figure>
      {%- endif -%}

      {%- if section.settings.badge_text != blank -%}
        <a class="badge-rotate hero__badge" href="{{ section.settings.badge_link | default: routes.all_products_collection_url }}" aria-label="{{ section.settings.badge_text | escape }}">
          <svg viewBox="0 0 132 132" aria-hidden="true">
            <defs><path id="HeroBadgePath-{{ section.id }}" d="M66,66 m-50,0 a50,50 0 1,1 100,0 a50,50 0 1,1 -100,0"/></defs>
            <text><textPath href="#HeroBadgePath-{{ section.id }}">{{ section.settings.badge_text | escape }}</textPath></text>
          </svg>
          <span class="badge-rotate__core" aria-hidden="true">↗</span>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.hero",
  "class": "section-hero",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "Malerei & Druckgrafik · Berlin" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Farbe in" },
    { "type": "text", "id": "heading_accent", "label": "t:labels.heading_accent", "info": "t:info.heading_accent_breathing", "default": "Bewegung" },
    { "type": "richtext", "id": "text", "label": "t:labels.text", "default": "<p>Farbfelder, die sich anziehen und abstoßen. Originale und kleine Editionen – direkt aus dem Atelier.</p>" },
    { "type": "text", "id": "button_label", "label": "t:labels.button_label", "default": "Werke entdecken" },
    { "type": "url", "id": "button_link", "label": "t:labels.button_link" },
    { "type": "text", "id": "link_label", "label": "t:labels.link_label", "default": "Showroom betreten" },
    { "type": "url", "id": "link", "label": "t:labels.link" },
    { "type": "header", "content": "t:labels.stage" },
    { "type": "product", "id": "product", "label": "t:labels.featured_product", "info": "t:info.featured_product" },
    { "type": "image_picker", "id": "image", "label": "t:labels.image" },
    { "type": "text", "id": "badge_text", "label": "t:labels.badge_text", "default": "Neue Werke · Herbst 2026 · " },
    { "type": "url", "id": "badge_link", "label": "t:labels.badge_link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "date",
      "name": "t:blocks.hero_date",
      "settings": [
        { "type": "text", "id": "label", "label": "t:labels.small_label", "default": "Demnächst" },
        { "type": "checkbox", "id": "live", "label": "t:labels.live_dot", "default": false },
        { "type": "text", "id": "title", "label": "t:labels.title", "default": "Farbräume" },
        { "type": "text", "id": "text", "label": "t:labels.text", "default": "Galerie Nord, Berlin · ab 14.11." },
        { "type": "url", "id": "link", "label": "t:labels.link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero",
      "blocks": [{ "type": "date" }]
    }
  ]
}
{% endschema %}

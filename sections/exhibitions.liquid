{% comment %}
  Exhibitions page. Every exhibition is a block; dates are text settings in the
  format YYYY-MM-DD (there is no date setting type). The section sorts blocks
  into "now showing", "upcoming" and "archive" on every render. Entries with an
  invalid date are listed at the end of "upcoming" and flagged in the editor.
  Note: storefront pages are cached, so the grouping can lag behind by a while.
{% endcomment %}
{{ 'section-exhibitions.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign scheme_id = section.settings.color_scheme.id | default: 'scheme-1'
  assign now_ts = 'now' | date: '%s' | plus: 0
  assign current_keys = ''
  assign upcoming_keys = ''
  assign past_keys = ''
  assign invalid_keys = ''

  for block in section.blocks
    assign idx = forloop.index0
    assign dates_ok = true
    assign start_ts = 0
    assign end_ts = 0

    for raw_date in (1..2)
      if raw_date == 1
        assign raw = block.settings.start_date | strip
      else
        assign raw = block.settings.end_date | strip
        if raw == blank
          continue
        endif
      endif
      assign date_ok = false
      if raw.size == 10
        assign parts = raw | split: '-'
        if parts.size == 3
          assign y = parts[0] | plus: 0
          assign m = parts[1] | plus: 0
          assign d = parts[2] | plus: 0
          assign y_s = y | prepend: '0000' | slice: -4, 4
          assign m_s = m | prepend: '00' | slice: -2, 2
          assign d_s = d | prepend: '00' | slice: -2, 2
          if y_s == parts[0] and m_s == parts[1] and d_s == parts[2] and y >= 1900 and m >= 1 and m <= 12 and d >= 1 and d <= 31
            assign date_ok = true
          endif
        endif
      endif
      if date_ok == false
        assign dates_ok = false
      elsif raw_date == 1
        assign start_ts = raw | date: '%s' | plus: 0
      else
        assign end_ts = raw | date: '%s' | plus: 86399
      endif
    endfor

    if dates_ok == false
      assign invalid_keys = invalid_keys | append: idx | append: ','
      continue
    endif
    if end_ts == 0
      assign end_ts = start_ts | plus: 86399
    endif

    assign start_pad = start_ts | prepend: '0000000000' | slice: -10, 10
    assign end_pad = end_ts | prepend: '0000000000' | slice: -10, 10
    if start_ts <= now_ts and end_ts >= now_ts
      assign current_keys = current_keys | append: start_pad | append: '|' | append: idx | append: '|' | append: start_ts | append: '|' | append: end_ts | append: ','
    elsif start_ts > now_ts
      assign upcoming_keys = upcoming_keys | append: start_pad | append: '|' | append: idx | append: '|' | append: start_ts | append: '|' | append: end_ts | append: ','
    else
      assign past_keys = past_keys | append: end_pad | append: '|' | append: idx | append: '|' | append: start_ts | append: '|' | append: end_ts | append: ','
    endif
  endfor

  assign current_list = current_keys | split: ',' | sort
  assign upcoming_list = upcoming_keys | split: ',' | sort
  assign past_list = past_keys | split: ',' | sort | reverse
  assign invalid_list = invalid_keys | split: ','
  assign has_live = false
  if current_list.size > 0 or upcoming_list.size > 0 or invalid_list.size > 0
    assign has_live = true
  endif
-%}

<div class="exhibitions section-pad color-scheme color-{{ scheme_id }}" data-exhibitions>
  <header class="section-head">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="section-title">{{ section.settings.heading }}</h1>
    </div>
    {%- if section.settings.intro != blank -%}
      <div class="section-intro rte">{{ section.settings.intro }}</div>
    {%- endif -%}
  </header>

  {%- if current_list.size > 0 -%}
    <div class="exhibitions__group" data-group="current">
      <h2 class="visually-hidden">{{ 'exhibitions.now_showing' | t }}</h2>
      {%- for key in current_list -%}
        {%- assign k = key | split: '|' -%}
        {%- assign bi = k[1] | plus: 0 -%}
        {%- assign block = section.blocks[bi] -%}
        {% render 'exhibition-item', block: block, variant: 'current', start_ts: k[2], end_ts: k[3], valid: true %}
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if upcoming_list.size > 0 or invalid_list.size > 0 -%}
    <div class="exhibitions__group" data-group="upcoming">
      <h2 class="exhibitions__label">{{ 'exhibitions.upcoming' | t }}</h2>
      <div class="exhibitions__upcoming">
        {%- for key in upcoming_list -%}
          {%- assign k = key | split: '|' -%}
          {%- assign bi = k[1] | plus: 0 -%}
        {%- assign block = section.blocks[bi] -%}
          {%- if forloop.first -%}
            {% render 'exhibition-item', block: block, variant: 'feature', start_ts: k[2], end_ts: k[3], valid: true, image_loading: 'eager' %}
          {%- else -%}
            {% render 'exhibition-item', block: block, variant: 'card', start_ts: k[2], end_ts: k[3], valid: true %}
          {%- endif -%}
        {%- endfor -%}
        {%- for idx in invalid_list -%}
          {%- assign bi = idx | plus: 0 -%}
          {%- assign block = section.blocks[bi] -%}
          {% render 'exhibition-item', block: block, variant: 'card', start_ts: 0, end_ts: 0, valid: false %}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- if has_live == false -%}
    <div class="exhibitions__empty" data-exhibitions-empty>
      <div class="exhibitions__empty-art" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
      <div>
        <h2>{{ section.settings.empty_heading | escape }}</h2>
        {%- if section.settings.empty_text != blank -%}
          <div class="rte">{{ section.settings.empty_text }}</div>
        {%- endif -%}
        {%- if section.settings.empty_link != blank and section.settings.empty_link_label != blank -%}
          <a class="btn" href="{{ section.settings.empty_link }}">{{ section.settings.empty_link_label | escape }}</a>
        {%- endif -%}
        {%- if request.design_mode and section.blocks.size == 0 -%}
          <p class="exhibitions__hint">{{ 'exhibitions.editor_hint' | t }}</p>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- if section.settings.show_past and past_list.size > 0 -%}
    <div class="exhibitions__archive" data-group="past">
      <div class="exhibitions__archive-head">
        <h2 class="exhibitions__label">{{ 'exhibitions.archive' | t }}</h2>
        <span>{{ 'exhibitions.archive_count' | t: count: past_list.size }}</span>
      </div>
      <ul class="exhibitions__archive-list" role="list">
        {%- for key in past_list limit: section.settings.past_limit -%}
          {%- assign k = key | split: '|' -%}
          {%- assign bi = k[1] | plus: 0 -%}
        {%- assign block = section.blocks[bi] -%}
          {% render 'exhibition-item', block: block, variant: 'archive', start_ts: k[2], end_ts: k[3], valid: true %}
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.exhibitions",
  "class": "section-exhibitions",
  "max_blocks": 50,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Ausstellungen"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:info.heading_accent",
      "default": "Wo die Bilder <em>hängen</em>"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "t:labels.intro",
      "default": "<p>Kommende und laufende Ausstellungen, Vernissagen und offene Ateliers. Der Eintritt ist fast überall frei.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_past",
      "label": "t:labels.show_past",
      "default": true
    },
    {
      "type": "range",
      "id": "past_limit",
      "min": 1,
      "max": 50,
      "step": 1,
      "label": "t:labels.past_limit",
      "default": 12
    },
    {
      "type": "header",
      "content": "t:labels.empty_state"
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "t:labels.heading",
      "default": "Gerade keine Ausstellung geplant."
    },
    {
      "type": "richtext",
      "id": "empty_text",
      "label": "t:labels.text",
      "default": "<p>Neue Termine kündige ich hier und im Newsletter an. Bis dahin: Der Showroom ist immer offen.</p>"
    },
    {
      "type": "text",
      "id": "empty_link_label",
      "label": "t:labels.link_label",
      "default": "Showroom betreten"
    },
    {
      "type": "url",
      "id": "empty_link",
      "label": "t:labels.link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "exhibition",
      "name": "t:blocks.exhibition",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.title",
          "default": "Neue Ausstellung"
        },
        {
          "type": "select",
          "id": "kind",
          "label": "t:labels.exhibition_kind",
          "options": [
            { "value": "solo", "label": "t:options.exhibition_kind.solo" },
            { "value": "group", "label": "t:options.exhibition_kind.group" },
            { "value": "fair", "label": "t:options.exhibition_kind.fair" },
            { "value": "open_studio", "label": "t:options.exhibition_kind.open_studio" }
          ],
          "default": "solo"
        },
        {
          "type": "text",
          "id": "start_date",
          "label": "t:labels.start_date",
          "info": "t:info.date_format",
          "placeholder": "2026-11-14"
        },
        {
          "type": "text",
          "id": "end_date",
          "label": "t:labels.end_date",
          "info": "t:info.end_date",
          "placeholder": "2026-12-20"
        },
        {
          "type": "text",
          "id": "opening",
          "label": "t:labels.opening",
          "placeholder": "Vernissage Fr 13.11., 19 Uhr"
        },
        {
          "type": "text",
          "id": "venue",
          "label": "t:labels.venue"
        },
        {
          "type": "text",
          "id": "city",
          "label": "t:labels.city"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "t:labels.description"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "t:labels.link"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:labels.link_label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.exhibitions",
      "blocks": [
        {
          "type": "exhibition"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}

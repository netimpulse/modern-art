{% comment %}
  Site footer: big statement line, optional newsletter (off by default, check
  double opt-in + privacy text in the admin before enabling), contact text,
  footer menu, store policies + imprint page, social links, payment icons.
{% endcomment %}
{{ 'section-footer.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign menu = section.settings.menu
  if menu == blank or menu.links.size == 0
    assign menu = linklists['footer']
  endif
  assign scheme_id = section.settings.color_scheme.id | default: 'scheme-2'
-%}

<footer class="site-footer full-width color-scheme color-{{ scheme_id }}">
  <span class="blob blob--cobalt site-footer__blob site-footer__blob--1" aria-hidden="true"></span>
  <span class="blob blob--coral site-footer__blob site-footer__blob--2" aria-hidden="true"></span>

  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <p class="site-footer__big">{{ section.settings.heading | escape }}</p>
    {%- endif -%}

    <div class="site-footer__grid">
      <div class="site-footer__col">
        {%- if section.settings.show_newsletter -%}
          <h2 class="site-footer__title">{{ section.settings.newsletter_heading | escape }}</h2>
          {%- form 'customer', id: 'FooterNewsletter', class: 'site-footer__newsletter' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="field">
              <label for="FooterNewsletterEmail">{{ 'footer.newsletter_label' | t }}</label>
              <div class="field-row">
                <input
                  id="FooterNewsletterEmail"
                  class="input"
                  type="email"
                  name="contact[email]"
                  autocomplete="email"
                  required
                  placeholder="{{ 'footer.newsletter_placeholder' | t }}"
                  {% if form.errors %}
                    aria-invalid="true" aria-describedby="FooterNewsletterMessage"
                  {% endif %}
                >
                <button type="submit" class="btn">{{ 'footer.newsletter_submit' | t }}</button>
              </div>
            </div>
            {%- if form.errors -%}
              <p id="FooterNewsletterMessage" class="form-message form-message--error" role="alert">
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </p>
            {%- elsif form.posted_successfully? -%}
              <p class="form-message form-message--success" role="status">{{ 'footer.newsletter_success' | t }}</p>
            {%- endif -%}
            <p class="site-footer__consent">{{ 'footer.newsletter_consent' | t }}</p>
          {%- endform -%}
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="site-footer__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>

      {%- if menu.links.size > 0 -%}
        <nav class="site-footer__col" aria-labelledby="FooterMenuTitle-{{ section.id }}">
          <h2 class="site-footer__title" id="FooterMenuTitle-{{ section.id }}">{{ menu.title | escape }}</h2>
          <ul class="site-footer__list" role="list">
            {%- for link in menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}

      <nav class="site-footer__col" aria-labelledby="FooterLegalTitle-{{ section.id }}" data-footer-legal>
        <h2 class="site-footer__title" id="FooterLegalTitle-{{ section.id }}">{{ 'footer.legal' | t }}</h2>
        <ul class="site-footer__list" role="list">
          {%- for policy in shop.policies -%}
            <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
          {%- endfor -%}
          {%- if settings.imprint_page != blank -%}
            <li><a href="{{ settings.imprint_page.url }}">{{ 'footer.imprint' | t }}</a></li>
          {%- endif -%}
        </ul>

        {%- if section.settings.show_social -%}
          {%- capture social_links -%}
            {%- if settings.social_instagram != blank -%}
              <li><a href="{{ settings.social_instagram }}" rel="noopener" target="_blank">Instagram</a></li>
            {%- endif -%}
            {%- if settings.social_tiktok != blank -%}
              <li><a href="{{ settings.social_tiktok }}" rel="noopener" target="_blank">TikTok</a></li>
            {%- endif -%}
            {%- if settings.social_youtube != blank -%}
              <li><a href="{{ settings.social_youtube }}" rel="noopener" target="_blank">YouTube</a></li>
            {%- endif -%}
          {%- endcapture -%}
          {%- if social_links != blank -%}
            <h2 class="site-footer__title site-footer__title--spaced">{{ 'footer.social' | t }}</h2>
            <ul class="site-footer__list" role="list">{{ social_links }}</ul>
          {%- endif -%}
        {%- endif -%}
      </nav>
    </div>

    <div class="site-footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}</p>
      {%- if section.settings.show_payment_icons -%}
        <ul class="site-footer__payment" role="list">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:general.footer",
  "class": "section-footer",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Bleib in Bewegung."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.footer_text",
      "default": "<p>Atelier Modern Art<br>Besuche nach Vereinbarung</p>"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "footer"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "t:labels.show_social",
      "info": "t:info.show_social",
      "default": true
    },
    {
      "type": "header",
      "content": "t:labels.newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "t:labels.show_newsletter",
      "info": "t:info.show_newsletter",
      "default": false
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "t:labels.newsletter_heading",
      "default": "Neue Werke & Vernissagen"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-2"
    }
  ]
}
{% endschema %}

{% doc %}
  Legal price note next to prices (theme setting `tax_note_mode`).
  Links "shipping" to the store's shipping policy when one exists.

  @example
  {% render 'price-note' %}
{% enddoc %}
{%- unless settings.tax_note_mode == 'none' -%}
  {%- liquid
    assign shipping_label = 'price_note.shipping' | t
    if shop.shipping_policy.body != blank
      assign shipping = shipping_label | link_to: shop.shipping_policy.url
    else
      assign shipping = shipping_label
    endif
  -%}
  <p class="price-note" data-price-note>
    {%- if settings.tax_note_mode == 'small_business' -%}
      {{ 'price_note.small_business_html' | t: shipping: shipping }}
    {%- else -%}
      {{ 'price_note.incl_vat_html' | t: shipping: shipping }}
    {%- endif -%}
  </p>
{%- endunless -%}

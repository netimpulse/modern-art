{% doc %}
  Global design tokens (see CLAUDE.md → Designsystem).
  Fonts: bundled Syne + DM Sans (OFL, assets/*.woff2) or the font pickers.
  Colors: one `.color-<scheme-id>` rule per color scheme; the first scheme also
  feeds `:root`, so every element has defined tokens.
{% enddoc %}
{% style %}
  {%- if settings.use_bundled_fonts -%}
    @font-face {
      font-family: 'Syne';
      src: url('{{ 'syne-latin-ext.woff2' | asset_url }}') format('woff2');
      font-weight: 400 800;
      font-style: normal;
      font-display: swap;
      unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
    }
    @font-face {
      font-family: 'Syne';
      src: url('{{ 'syne-latin.woff2' | asset_url }}') format('woff2');
      font-weight: 400 800;
      font-style: normal;
      font-display: swap;
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }
    @font-face {
      font-family: 'DM Sans';
      src: url('{{ 'dm-sans-latin-ext.woff2' | asset_url }}') format('woff2');
      font-weight: 400 700;
      font-style: normal;
      font-display: swap;
      unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
    }
    @font-face {
      font-family: 'DM Sans';
      src: url('{{ 'dm-sans-latin.woff2' | asset_url }}') format('woff2');
      font-weight: 400 700;
      font-style: normal;
      font-display: swap;
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }
  {%- else -%}
    {{ settings.type_heading_font | font_face: font_display: 'swap' }}
    {{ settings.type_primary_font | font_face: font_display: 'swap' }}
    {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
    {{ settings.type_primary_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {%- endif -%}

  :root {
    {%- if settings.use_bundled_fonts %}
      --font-heading--family: 'Syne', system-ui, sans-serif;
      --font-heading--weight: 700;
      --font-primary--family: 'DM Sans', system-ui, sans-serif;
      --font-primary--style: normal;
      --font-primary--weight: 400;
    {%- else %}
      --font-heading--family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
      --font-heading--weight: {{ settings.type_heading_font.weight }};
      --font-primary--family: {{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }};
      --font-primary--style: {{ settings.type_primary_font.style }};
      --font-primary--weight: {{ settings.type_primary_font.weight }};
    {%- endif %}
    --page-width: {{ settings.max_page_width }};
    --page-margin: clamp({{ settings.min_page_margin }}px, 5vw, 56px);
    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;
    --radius-s: 10px;
    --radius-l: 28px;
    --shadow-soft: 0 1px 2px rgb(21 21 26 / 0.06), 0 18px 40px -18px rgb(21 21 26 / 0.28);
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    --space-section: clamp(80px, 12vw, 170px);
    --header-height: 72px;
  }

  {% for scheme in settings.color_schemes -%}
    {%- if forloop.first %}:root,{% endif %}
    .color-{{ scheme.id }} {
      --color-background: {{ scheme.settings.background }};
      --color-foreground: {{ scheme.settings.text }};
      --color-muted: {{ scheme.settings.muted }};
      --color-button: {{ scheme.settings.button }};
      --color-button-label: {{ scheme.settings.button_label }};
      --color-secondary-button-label: {{ scheme.settings.secondary_button_label }};
      --color-accent-1: {{ scheme.settings.accent_1 }};
      --color-accent-2: {{ scheme.settings.accent_2 }};
      --color-accent-3: {{ scheme.settings.accent_3 }};
      --color-surface: {{ scheme.settings.surface }};
      --color-mat: {{ scheme.settings.mat }};
      --color-line: color-mix(in srgb, {{ scheme.settings.text }} 14%, transparent);
      {%- if scheme.settings.background_gradient != blank %}
        --gradient-background: {{ scheme.settings.background_gradient }};
      {%- else %}
        --gradient-background: {{ scheme.settings.background }};
      {%- endif %}
    }
  {% endfor %}
{% endstyle %}

[
  {
    "name": "theme_info",
    "theme_name": "Modern Art",
    "theme_version": "1.0.0",
    "theme_author": "Modern Art Studio",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "checkbox",
        "id": "use_bundled_fonts",
        "label": "t:labels.use_bundled_fonts",
        "info": "t:info.use_bundled_fonts",
        "default": true
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "work_sans_n7",
        "label": "t:labels.heading_font"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:labels.body_font"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "82.5rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "100rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "82.5rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 40,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 18
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "t:labels.background",
            "default": "#F7F6F2"
          },
          {
            "type": "color_background",
            "id": "background_gradient",
            "label": "t:labels.background_gradient",
            "info": "t:info.background_gradient"
          },
          {
            "type": "color",
            "id": "text",
            "label": "t:labels.text",
            "default": "#15151A"
          },
          {
            "type": "color",
            "id": "muted",
            "label": "t:labels.muted",
            "default": "#55555F"
          },
          {
            "type": "color",
            "id": "button",
            "label": "t:labels.button",
            "default": "#15151A"
          },
          {
            "type": "color",
            "id": "button_label",
            "label": "t:labels.button_label",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "secondary_button_label",
            "label": "t:labels.secondary_button_label",
            "default": "#15151A"
          },
          {
            "type": "color",
            "id": "accent_1",
            "label": "t:labels.accent_1",
            "info": "t:info.accent_1",
            "default": "#2D3BE8"
          },
          {
            "type": "color",
            "id": "accent_2",
            "label": "t:labels.accent_2",
            "info": "t:info.accent_shapes",
            "default": "#FF5A36"
          },
          {
            "type": "color",
            "id": "accent_3",
            "label": "t:labels.accent_3",
            "info": "t:info.accent_shapes",
            "default": "#FFC93C"
          },
          {
            "type": "color",
            "id": "surface",
            "label": "t:labels.surface",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "mat",
            "label": "t:labels.mat",
            "info": "t:info.mat",
            "default": "#ECEAE4"
          }
        ],
        "role": {
          "text": "text",
          "background": {
            "solid": "background",
            "gradient": "background_gradient"
          },
          "links": "secondary_button_label",
          "icons": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "background",
          "on_secondary_button": "secondary_button_label",
          "secondary_button_border": "secondary_button_label"
        }
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 30,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 30
      }
    ]
  },
  {
    "name": "t:general.motion",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_animations",
        "label": "t:labels.enable_animations",
        "info": "t:info.enable_animations",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_cursor_effect",
        "label": "t:labels.enable_cursor_effect",
        "info": "t:info.enable_cursor_effect",
        "default": true
      }
    ]
  },
  {
    "name": "t:general.shop",
    "settings": [
      {
        "type": "select",
        "id": "tax_note_mode",
        "label": "t:labels.tax_note_mode",
        "info": "t:info.tax_note_mode",
        "options": [
          {
            "value": "incl_vat",
            "label": "t:options.tax_note_mode.incl_vat"
          },
          {
            "value": "small_business",
            "label": "t:options.tax_note_mode.small_business"
          },
          {
            "value": "none",
            "label": "t:options.tax_note_mode.none"
          }
        ],
        "default": "incl_vat"
      },
      {
        "type": "text",
        "id": "shipping_note_fallback",
        "label": "t:labels.shipping_note_fallback",
        "info": "t:info.shipping_note_fallback",
        "default": "Versichert verpackt · Lieferzeit 5–10 Werktage"
      }
    ]
  },
  {
    "name": "t:general.social_legal",
    "settings": [
      {
        "type": "page",
        "id": "imprint_page",
        "label": "t:labels.imprint_page",
        "info": "t:info.imprint_page"
      },
      {
        "type": "url",
        "id": "social_instagram",
        "label": "t:labels.social_instagram"
      },
      {
        "type": "url",
        "id": "social_tiktok",
        "label": "t:labels.social_tiktok"
      },
      {
        "type": "url",
        "id": "social_youtube",
        "label": "t:labels.social_youtube"
      }
    ]
  }
]
